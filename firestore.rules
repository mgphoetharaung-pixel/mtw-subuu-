rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Family Sync (invite-code model, no Cloud Functions required):
    // - Owner keeps their active secret in users/{ownerUid}.familyCodes (list, max 1).
    // - Viewer stores familyLinks.{ownerUid} = <secret> on their OWN profile.
    // Read access is granted only when the viewer's stored secret matches the
    // owner's active code. familyMembers/syncedWithOwner are legacy fields.
    function myFamilyProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFamilyMember(ownerUid) {
      return signedIn()
        && request.auth.uid != ownerUid
        && myFamilyProfile().get('familyLinks', {}).get(ownerUid, '') != ''
        && myFamilyProfile().get('familyLinks', {}).get(ownerUid, '') in get(/databases/$(database)/documents/users/$(ownerUid)).data.get('familyCodes', []);
    }

    // Admin records must be provisioned outside the client app.
    match /admins/{adminUid} {
      allow read: if isAdmin() || isOwner(adminUid);
      allow write: if false;
    }

    // User profile. Users cannot change plan, role, approval or expiry fields.
    // They may manage ONLY their own theme/language/family-link preferences.
    match /users/{userUid} {
      // Family members may READ the profile too (app subscribes to users/{activeUid});
      // writes remain owner/admin only.
      allow read: if isOwner(userUid) || isAdmin() || isFamilyMember(userUid);
      allow create: if isOwner(userUid)
        && request.resource.data.keys().hasOnly([
          'plan', 'role', 'name', 'profileUrl', 'syncCode', 'reminderTime', 'timezone',
          'theme', 'themeColor', 'language', 'familyCodes', 'familyLinks',
          'createdAt', 'updatedAt'
        ])
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'Free')
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isAdmin()
        || (isOwner(userUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'profileUrl', 'syncCode', 'reminderTime', 'timezone',
            'theme', 'themeColor', 'language', 'familyCodes', 'familyLinks', 'updatedAt'
          ]));
      allow delete: if isAdmin();

      // Personal finance collections are private to the owner.
      // Family members (matched via invite codes) get READ-ONLY access only.
      match /{subPath=**} {
        allow read: if isOwner(userUid) || isAdmin() || isFamilyMember(userUid);
        allow create, update, delete: if isOwner(userUid) || isAdmin();
      }
    }

    // A user may submit a payment request and read their own requests.
    // Only an admin can change status, approval, plan, or expiry fields.
    match /paymentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['1 Month', '3 Months', '6 Months', '1 Year', 'Lifetime']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Optional audit trail for administrative decisions.
    match /paymentAudit/{auditId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Legacy collection from an older design; kept fully locked.
    match /sync_codes/{code} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
